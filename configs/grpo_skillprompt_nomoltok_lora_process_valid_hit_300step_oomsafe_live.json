{
  "device": "cuda:0",
  "seed": 42,
  "steps": 300,
  "batch_size": 1,
  "ppo_epochs": 1,
  "learning_rate": 5e-6,
  "clip_eps": 0.2,
  "entropy_coef": 0.003,
  "grpo_group_size": 2,
  "grpo_adv_clip": 4.0,
  "max_new_tokens": 96,
  "rollout_search_depth": 2,
  "rollout_search_width": 2,
  "temperature": 0.8,
  "top_p": 0.95,
  "top_k": 0,
  "constraint_guidance": true,
  "constrained_decoding": true,
  "reward_mode": "process_valid_hit",
  "invalid_reward": -1.0,
  "process_valid_base": 0.0,
  "process_hit_weight": 0.0,
  "process_loose_reward": 1.0,
  "process_strict_reward": 2.0,
  "process_margin_weight": 1.0,
  "process_margin_cap": 1.0,
  "process_strict_bonus": 0.0,
  "task_priority_sampling": true,
  "task_priority_alpha": 1.5,
  "task_priority_floor": 0.2,
  "adv_normalize": false,
  "use_strict_priority_adv": true,
  "strict_priority_adv_blend": 0.9,
  "strict_positive_adv_floor": 0.5,
  "non_hit_positive_damp": 0.2,
  "use_strict_weighted_ppo": true,
  "strict_gate_when_available": true,
  "strict_gate_non_strict_weight": 0.05,
  "strict_gate_strict_boost": 1.5,
  "strict_pairwise_coef": 0.8,
  "strict_pairwise_margin": 0.05,
  "strict_pairwise_all_negatives": true,
  "use_recoverability_shaping": false,
  "use_recoverability_weight": true,
  "recoverability_weight_kappa": 1.5,
  "recoverability_weight_cap": 3.0,
  "top1_imitation_coef": 0.5,
  "elite_replay_coef": 0.1,
  "elite_replay_per_step": 1,
  "elite_pool_per_task": 8,
  "near_replay_coef": 0.0,
  "near_replay_per_step": 0,
  "save_every": 25,
  "grad_clip": 1.0,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "codebook_size": 256,
  "num_codebooks": 8,
  "mol_token_format": "shared",
  "max_atom_map": 256,
  "max_fg_id": 64,
  "register_domain_vocab": true,
  "gradient_checkpointing": true
}
